{
  "name": "keyturn",
  "version": "1.5.0",
  "description": "Keyturn — an RMM-agnostic command center for managing organizations, infrastructure, and endpoints through safe natural-language workflows. First connector: NinjaOne (MCP over stdio).",
  "private": true,
  "homepage": "https://github.com/Solve4x-ai/Keyturn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solve4x-ai/Keyturn.git"
  },
  "bugs": {
    "url": "https://github.com/Solve4x-ai/Keyturn/issues"
  },
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js",
    "test": "node --test tests/*.test.mjs",
    "test:runner": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tests/powershell-runner.test.ps1",
    "test:live": "node --require dotenv/config dist/test.js",
    "verify": "npm run build && npm test && npm run test:runner",
    "setup": "node scripts/setup.mjs",
    "auth": "node --require dotenv/config dist/auth.js",
    "auth:command": "node --require dotenv/config dist/auth.js dotenv_config_path=config/command.env",
    "serve": "node --require dotenv/config dist/serve.js",
    "ui": "node scripts/ui.mjs",
    "demo": "npm run build && node --no-warnings scripts/demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^16.4.5",
    "fastify": "5.12.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "msp",
    "rmm",
    "ninjaone",
    "ai-agents",
    "claude",
    "webauthn",
    "passkeys",
    "active-directory",
    "it-automation",
    "keyturn"
  ],
  "author": {
    "name": "Solve4x",
    "email": "support@solve4x.ai",
    "url": "https://solve4x.ai"
  },
  "license": "MIT"
}
