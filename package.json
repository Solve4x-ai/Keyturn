{
  "name": "mission-control",
  "version": "1.5.0",
  "description": "Mission Control — an RMM-agnostic command center for managing organizations, infrastructure, and endpoints through safe natural-language workflows. First connector: NinjaOne (MCP over stdio).",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js",
    "test": "node --test tests/*.test.mjs",
    "test:runner": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tests/powershell-runner.test.ps1",
    "test:live": "node --require dotenv/config dist/test.js",
    "verify": "npm run build && npm test && npm run test:runner",
    "auth": "node --require dotenv/config dist/auth.js",
    "serve": "node --require dotenv/config dist/serve.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^16.4.5",
    "fastify": "5.12.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "mission-control",
    "msp",
    "ninja",
    "rmm",
    "monitoring",
    "security",
    "audit",
    "webauthn"
  ],
  "author": "Solve4x",
  "license": "MIT"
}
