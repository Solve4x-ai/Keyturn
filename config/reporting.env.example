# Reporting profile — NinjaOne API Services app (Client Credentials), read-only.
# `npm run setup` fills this in; you can also edit it by hand.
NINJA_AUTH_PROFILE=reporting
NINJA_CLIENT_ID=REPLACE_WITH_REPORTING_CLIENT_ID
NINJA_CLIENT_SECRET=REPLACE_WITH_REPORTING_CLIENT_SECRET
# Your region's host: app (us), us2, eu, ca, or oc — e.g. https://eu.ninjarmm.com
NINJA_BASE_URL=https://app.ninjarmm.com
NINJA_SCOPES=monitoring
# Absolute path — MCP clients start the server from their own directory.
NINJA_POLICY_PATH=C:\Keyturn\config\policy.json
MCP_MODE=stdio
LOG_LEVEL=info
