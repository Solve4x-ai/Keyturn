# Command profile — NinjaOne Native app (Authorization Code + PKCE).
# `npm run setup` fills this in; you can also edit it by hand.
NINJA_AUTH_PROFILE=command
NINJA_AUTH_FLOW=pkce
NINJA_NATIVE_CLIENT_ID=REPLACE_WITH_NATIVE_CLIENT_ID
# Your region's host: app (us), us2, eu, ca, or oc — e.g. https://eu.ninjarmm.com
NINJA_BASE_URL=https://app.ninjarmm.com
NINJA_SCOPES=monitoring management offline_access
# Must match the redirect URI registered on the Native app exactly.
NINJA_REDIRECT_URI=http://127.0.0.1
# Absolute path — MCP clients start the server from their own directory.
NINJA_POLICY_PATH=C:\Mission-Control\config\policy.json
# Refresh token location (default: %USERPROFILE%\.ninjaone-mcp\command\tokens.json)
# NINJA_TOKEN_PATH=
MCP_MODE=stdio
LOG_LEVEL=info
# Never add a client secret here — Native apps don't have one.
